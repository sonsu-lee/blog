---
import EntryList from '../components/EntryList.astro';
import Section from '../components/Section.astro';
import SiteFrame from '../components/SiteFrame.astro';
import { pageTitle } from '../data/profile';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts, postPath } from '../lib/posts';

const RECENT = 3;
const posts = (await getPosts()).slice(0, RECENT);
---

<BaseLayout title={pageTitle('Page not found')} noindex>
  <SiteFrame>
    <div class="intro">
      <h1>404</h1>
      <p>찾으시는 페이지가 없습니다. 주소가 바뀌었을 수 있어요.</p>
      <p><a href="/">Go home</a></p>
    </div>
    {
      posts.length > 0 && (
        <Section label="Writing" content="list">
          <EntryList entries={posts.map((p) => ({ title: p.data.title, description: p.data.description, href: postPath(p) }))} />
        </Section>
      )
    }
  </SiteFrame>
</BaseLayout>

<style>
  .intro {
    margin-bottom: var(--section-gap);
  }

  /* Title and its one-line explanation sit together, like a post's title and date. */
  h1 {
    font-weight: 600;
  }

  .intro p {
    color: var(--color-text-muted);
  }

  .intro p + p {
    margin-top: var(--space-4);
  }
</style>
