---
import EntryList from '../../components/EntryList.astro';
import Section from '../../components/Section.astro';
import { pageTitle } from '../../data/profile';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getPosts, groupByYear, postPath } from '../../lib/posts';

const posts = await getPosts();
const summary = posts.length === 0 ? 'Nothing here yet.' : `${posts.length} ${posts.length === 1 ? 'post' : 'posts'}.`;
---

<SiteLayout title={pageTitle('Writing')} description={summary}>
  <div class="intro">
    <h1>Writing</h1>
    <p>{summary}</p>
  </div>

  {
    groupByYear(posts).map(([year, items]) => (
      <Section label={String(year)} content="list">
        <EntryList entries={items.map((p) => ({ title: p.data.title, description: p.data.description, href: postPath(p) }))} />
      </Section>
    ))
  }
</SiteLayout>

<style>
  .intro {
    margin-bottom: var(--space-24);
  }

  .intro p {
    color: var(--color-text-muted);
  }

  /* Years sit closer together than home sections: they are one list, split by time. */
  .intro ~ :global(.section + .section) {
    margin-top: var(--space-16);
  }

  @media (max-width: 639px) {
    .intro {
      margin-bottom: var(--space-16);
    }

    .intro ~ :global(.section + .section) {
      margin-top: var(--space-12);
    }
  }
</style>
