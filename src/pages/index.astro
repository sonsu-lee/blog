---
import EntryList from '../components/EntryList.astro';
import ProfileLinks from '../components/ProfileLinks.astro';
import Section from '../components/Section.astro';
import { pageTitle, summary } from '../data/profile';
import { projects } from '../data/projects';
import SiteLayout from '../layouts/SiteLayout.astro';
import { getPosts, postPath } from '../lib/posts';

const LATEST = 5;

const posts = await getPosts();
---

<SiteLayout title={pageTitle()} description={summary}>
  <Section label="지금">
    <p>{summary}</p>
    <p>이 블로그에는 만들면서 배운 것들을 기록합니다.</p>
  </Section>

  {
    posts.length > 0 && (
      <Section label="글" content="list">
        <EntryList
          entries={posts.slice(0, LATEST).map((p) => ({ title: p.data.title, description: p.data.description, href: postPath(p) }))}
        />
        <p class="all">
          <a href="/posts/">모든 글</a> →
        </p>
      </Section>
    )
  }

  {
    projects.length > 0 && (
      <Section label="프로젝트" content="list">
        <EntryList entries={projects.map((p) => ({ title: p.name, description: p.description, href: p.href, external: true }))} />
      </Section>
    )
  }

  <Section label="구독">
    <p>새 글은 <a href="/rss.xml">RSS</a>로 받아볼 수 있습니다.</p>
  </Section>

  <Section label="더 보기">
    <p>저에 대한 이야기는 <a href="/about/">소개</a>에 있습니다.</p>
    <ProfileLinks />
  </Section>
</SiteLayout>

<style>
  .all {
    margin-top: var(--space-4);
    color: var(--color-text-muted);
  }

  @media (max-width: 639px) {
    .all {
      margin-top: var(--space-5);
    }
  }
</style>
