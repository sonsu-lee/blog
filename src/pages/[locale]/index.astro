---
import EntryList from '../../components/EntryList.astro';
import LinkedText from '../../components/LinkedText.astro';
import ProfileLinks from '../../components/ProfileLinks.astro';
import Section from '../../components/Section.astro';
import { projects } from '../../data/projects';
import type { Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import { alternatesFor, localeFile, localePath, localeStaticPaths } from '../../i18n/utils';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getPosts, postPath } from '../../lib/posts';

export function getStaticPaths() {
  return localeStaticPaths();
}

const LATEST = 5;

const locale = Astro.params.locale as Locale;
const t = useTranslations(locale);
const posts = await getPosts(locale);
---

<SiteLayout locale={locale} title="Sonsu Lee" description={t('home.now.body')} alternates={alternatesFor()}>
  <Section label={t('home.now')}>
    <p>{t('home.now.body')}</p>
    <p>{t('home.now.blog')}</p>
  </Section>

  {
    posts.length > 0 && (
      <Section label={t('home.writing')} content="list">
        <EntryList
          entries={posts.slice(0, LATEST).map((p) => ({ title: p.data.title, description: p.data.description, href: postPath(p) }))}
        />
        <p class="all">
          <a href={localePath(locale, 'posts')}>{t('home.allPosts')}</a> →
        </p>
      </Section>
    )
  }

  {
    projects.length > 0 && (
      <Section label={t('home.projects')} content="list">
        <EntryList entries={projects.map((p) => ({ title: p.name, description: p.description[locale], href: p.href, external: true }))} />
      </Section>
    )
  }

  <Section label={t('home.subscribe')}>
    <p>
      <LinkedText text={t('home.subscribe.body')} token="rss" href={localeFile(locale, 'rss.xml')} label="RSS" />
    </p>
  </Section>

  <Section label={t('home.more')}>
    <p>
      <LinkedText text={t('home.more.about')} token="about" href={localePath(locale, 'about')} label={t('about.title')} />
    </p>
    <ProfileLinks locale={locale} />
  </Section>
</SiteLayout>

<style>
  .all {
    margin-top: var(--space-4);
    color: var(--color-text-muted);
  }

  @media (max-width: 639px) {
    .all {
      margin-top: var(--space-5);
    }
  }
</style>
