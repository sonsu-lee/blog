---
import EntryList from '../../../components/EntryList.astro';
import Section from '../../../components/Section.astro';
import { pageTitle } from '../../../data/profile';
import type { Locale } from '../../../i18n/config';
import { useTranslations } from '../../../i18n/ui';
import { alternatesFor, localeStaticPaths } from '../../../i18n/utils';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { getPosts, groupByYear, postPath } from '../../../lib/posts';

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale = Astro.params.locale as Locale;
const t = useTranslations(locale);
const posts = await getPosts(locale);
const summary = t(posts.length === 1 ? 'posts.summary.one' : 'posts.summary.other', { count: posts.length });
---

<SiteLayout locale={locale} title={pageTitle(t('posts.title'))} description={summary} alternates={alternatesFor('posts')}>
  <div class="intro">
    <h1>{t('posts.title')}</h1>
    <p>{posts.length > 0 ? summary : t('posts.empty')}</p>
  </div>

  {
    groupByYear(posts).map(([year, items]) => (
      <Section label={String(year)} content="list">
        <EntryList entries={items.map((p) => ({ title: p.data.title, description: p.data.description, href: postPath(p) }))} />
      </Section>
    ))
  }
</SiteLayout>

<style>
  .intro {
    margin-bottom: var(--space-24);
  }

  .intro p {
    color: var(--color-text-muted);
  }

  /* Years sit closer together than home sections: they are one list, split by time. */
  .intro ~ :global(.section + .section) {
    margin-top: var(--space-16);
  }

  @media (max-width: 639px) {
    .intro {
      margin-bottom: var(--space-16);
    }

    .intro ~ :global(.section + .section) {
      margin-top: var(--space-12);
    }
  }
</style>
