---
import ProfileLinks from '../../components/ProfileLinks.astro';
import Section from '../../components/Section.astro';
import { name, pageTitle, visibleLinks } from '../../data/profile';
import type { Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import { alternatesFor, localeStaticPaths } from '../../i18n/utils';
import SiteLayout from '../../layouts/SiteLayout.astro';

export function getStaticPaths() {
  return localeStaticPaths();
}

// Like emilkowal.ski: no work history here; the home page's "Now" names the current job.
const locale = Astro.params.locale as Locale;
const t = useTranslations(locale);
---

<SiteLayout locale={locale} title={pageTitle(t('about.title'))} description={t('about.intro', { name })} alternates={alternatesFor('about')}>
  <div class="intro">
    <h1>{t('about.title')}</h1>
    <p>{t('about.intro', { name })}</p>
    <p>{t('about.languages')}</p>
  </div>

  {
    visibleLinks.length > 0 && (
      <Section label={t('home.more')}>
        <ProfileLinks locale={locale} />
      </Section>
    )
  }
</SiteLayout>

<style>
  .intro {
    margin-bottom: var(--section-gap);
  }

  h1 {
    margin-bottom: var(--space-8);
    font-weight: 600;
  }

  .intro p {
    color: var(--color-text-prose);
  }

  .intro p + p {
    margin-top: var(--prose-paragraph);
  }
</style>
