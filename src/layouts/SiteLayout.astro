---
import SiteFrame from '../components/SiteFrame.astro';
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  published?: Date;
}

const { title, description, image, published } = Astro.props;
---

<BaseLayout title={title} description={description} image={image} published={published}>
  <SiteFrame>
    <slot />
  </SiteFrame>
</BaseLayout>
