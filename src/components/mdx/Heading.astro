---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'h2'>;

// Used for every h2 in MDX posts. Visually hidden headings (such as the
// footnotes label) pass through untouched.
const { id, class: className, ...rest } = Astro.props;
const plain = !id || String(className ?? '').includes('sr-only');
---

{
  plain ? (
    <h2 id={id} class={className} {...rest}>
      <slot />
    </h2>
  ) : (
    <h2 id={id} class={className} {...rest}>
      <a class="anchor" href={`#${id}`}>
        <slot />
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
          <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
        </svg>
      </a>
    </h2>
  )
}

<style>
  /* The whole heading links to itself; a link icon appears in the left margin on hover or focus. */
  .anchor {
    position: relative;
    display: block;
    width: fit-content;
    color: inherit;
    text-decoration: none;
  }

  /* As on emilkowal.ski: the icon takes the heading's color and fades in over 150ms. */
  svg {
    position: absolute;
    top: 3px;
    left: -24px;
    opacity: 0;
    transition: opacity var(--duration-base) var(--ease-standard);
  }

  .anchor:focus-visible svg {
    opacity: 1;
  }

  @media (hover: hover) and (pointer: fine) {
    .anchor:hover svg {
      opacity: 1;
    }
  }
</style>
