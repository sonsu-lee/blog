---
import type { HTMLAttributes } from 'astro/types';
import type { Locale } from '../i18n/config';
import Header from './Header.astro';

type Props = HTMLAttributes<'div'> & {
  locale: Locale;
  alternates: Record<Locale, string>;
};

const { locale, alternates, class: className, ...rest } = Astro.props;
---

<div class:list={['page', className]} {...rest}>
  <Header locale={locale} alternates={alternates} />
  <main>
    <slot />
  </main>
</div>

<style>
  /* A 692px column with 24px gutters: text runs at 644px, and list rows can bleed 12px into the gutter. */
  .page {
    max-width: var(--layout-column);
    margin-inline: auto;
    padding: var(--page-pad-top) var(--layout-gutter) var(--page-pad-bottom);
  }
</style>
