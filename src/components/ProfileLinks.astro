---
import { visibleLinks } from '../data/profile';
---

{
  visibleLinks.length > 0 && (
    <p class="links">
      {visibleLinks.map((link, i) => (
        <>
          {i > 0 && <span aria-hidden="true"> · </span>}
          <a href={link.href} {...(!link.href.startsWith('mailto:') && { target: '_blank', rel: 'noopener me' })}>
            {link.label}
          </a>
        </>
      ))}
    </p>
  )
}
