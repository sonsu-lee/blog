---
import ThemeIcon from '../icons/theme.svg';
---

<button type="button" class="theme-toggle" aria-label="Toggle dark mode" data-theme-toggle>
  <ThemeIcon aria-hidden="true" />
</button>

<script>
  import { applyTheme, currentTheme } from '../lib/theme';

  // Flip between light and dark and remember the choice. Until the reader picks one,
  // the page follows the system setting (tokens.css).
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
    button.addEventListener('click', () => applyTheme(currentTheme() === 'dark' ? 'light' : 'dark'));
  }
</script>

<style>
  .theme-toggle {
    position: relative;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-sm);
    background: none;
    color: var(--color-text-muted);
    cursor: pointer;
  }

  /* A 44px touch target around the 24px button. */
  .theme-toggle::after {
    content: '';
    position: absolute;
    inset: -10px;
  }

  @media (hover: hover) and (pointer: fine) {
    .theme-toggle:hover {
      color: var(--color-text-default);
    }
  }
</style>
