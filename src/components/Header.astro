---
import { name, role } from '../data/profile';
import ThemeToggle from './ThemeToggle.astro';
---

<header>
  <p class="identity">
    <a href="/">{name}</a>
    <span>{role}</span>
  </p>
  <ThemeToggle />
</header>

<style>
  /* Named so page navigations crossfade the content while the header holds its place. */
  header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-4);
    margin-bottom: var(--space-32);
    line-height: 24px;
    view-transition-name: site-header;
  }

  .identity {
    display: flex;
    flex-direction: column;
    font-weight: 500;
  }

  .identity a {
    text-decoration: none;
  }

  /* The role sits tight under the name (16px line), so the header is 40px tall. */
  .identity span {
    color: var(--color-text-muted);
    line-height: 16px;
  }
</style>
